sequenceDiagram
  autonumber
  actor Contractor as Assigned Contractor
  actor Landowner as Project Owner
  actor Admin as Administrator
  participant UI as React Presentation Layer
  participant ExecSvc as executionService.js
  participant StorageAPI as Supabase Storage
  participant DB as PostgreSQL

  Contractor->>UI: Start or resume milestone
  UI->>ExecSvc: updateMilestoneStatus(id, in_progress)
  ExecSvc->>DB: RPC update_milestone_status(id, in_progress, null)
  DB->>DB: Lock milestone/package; validate actor and old status
  DB-->>ExecSvc: Updated milestone row

  Contractor->>UI: Submit progress notes and optional photos
  UI->>StorageAPI: Upload photo to {package_id}/{milestone_id}/{filename}
  StorageAPI-->>UI: Private object path
  UI->>ExecSvc: submitProgressUpdate(id, notes, percentage, photoPaths)
  ExecSvc->>DB: INSERT progress_updates
  UI->>ExecSvc: updateMilestoneStatus(id, submitted_for_review)
  ExecSvc->>DB: RPC update_milestone_status(id, submitted_for_review, null)
  DB->>DB: Lock row; verify assigned contractor and transition
  DB-->>UI: Updated milestone row

  alt Project owner approves
    Landowner->>UI: Approve submitted milestone
    UI->>ExecSvc: updateMilestoneStatus(id, approved)
    ExecSvc->>DB: RPC update_milestone_status(id, approved, null)
  else Project owner or admin requests rework
    Landowner->>UI: Request rework with notes
    UI->>ExecSvc: updateMilestoneStatus(id, rework_required, notes)
    ExecSvc->>DB: RPC update_milestone_status(id, rework_required, notes)
  end
  DB->>DB: Validate reviewer and transition; update status fields only
  DB-->>UI: Updated milestone row or authorization error
