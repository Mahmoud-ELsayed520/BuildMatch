classDiagram
  direction TB

  class Profile {
    +UUID id
    +String role
    +String fullName
    +String phone
    +String city
    +String avatarUrl
    +DateTime createdAt
    +updateProfile()
  }

  class ContractorProfile {
    +String businessName
    +String bio
    +String[] specializations
    +int yearsOfExperience
    +String verificationStatus
    +DateTime verifiedAt
    +Object[] portfolioItems
    +submitKYC()
    +updateCommercialProfile()
  }

  class VerificationDocument {
    +UUID id
    +String documentType
    +String filePath
    +String fileName
    +String verificationStatus
    +uploadDocument()
    +verifyDocument()
  }

  class Project {
    +UUID id
    +String title
    +String description
    +String city
    +String district
    +decimal landAreaSqm
    +int floorsCount
    +String constructionType
    +decimal estimatedBudget
    +String status
    +createProject()
    +publishToMarketplace()
    +cancelProject()
  }

  class ProjectFile {
    +UUID id
    +String fileCategory
    +String filePath
    +boolean isPublic
    +uploadDrawing()
    +downloadDrawing()
  }

  class ProjectPackage {
    +UUID id
    +String title
    +String category
    +String scopeOfWork
    +decimal estimatedBudget
    +int targetDurationDays
    +String status
    +DateTime assignedAt
    +createPackage()
    +awardContractor()
    +requestHandover()
    +completePackage()
  }

  class Proposal {
    +UUID id
    +decimal totalPrice
    +int proposedDurationDays
    +String scopeSummary
    +String paymentScheduleTerms
    +String status
    +int version
    +submitProposal()
    +withdrawProposal()
    +acceptProposal()
    +rejectProposal()
  }

  class ProposalItem {
    +UUID id
    +String itemDescription
    +decimal quantity
    +String unit
    +decimal unitPrice
    +decimal totalPrice
    +calculateTotal()
  }

  class Milestone {
    +UUID id
    +String title
    +int sequenceOrder
    +Date dueDate
    +decimal paymentPercentage
    +decimal paymentAmount
    +String status
    +logProgress()
    +submitForReview()
    +approve()
    +requestRework()
  }

  class ProgressUpdate {
    +UUID id
    +String notes
    +int percentageCompleted
    +Object[] photos
    +addPhotoEvidence()
  }

  class ChangeRequest {
    +UUID id
    +String title
    +String reason
    +String scopeChangeDescription
    +decimal costImpact
    +int timeImpactDays
    +String status
    +submitRequest()
    +approve()
    +reject()
  }

  class Review {
    +UUID id
    +int ratingOverall
    +int ratingQuality
    +int ratingPunctuality
    +int ratingCommunication
    +String comment
    +boolean isVerifiedCompletion
    +publishReview()
  }

  class Notification {
    +UUID id
    +String title
    +String message
    +boolean isRead
    +markAsRead()
  }

  class AuditLog {
    +UUID id
    +String action
    +String entityType
    +UUID entityId
    +Object details
    +DateTime createdAt
    +recordLog()
  }

  %% Inheritance / Specialization
  Profile <|-- ContractorProfile : extends (1:1)

  %% Associations
  Profile "1" --> "*" Project : owns
  ContractorProfile "1" --> "*" VerificationDocument : submits
  Project "1" *-- "*" ProjectFile : contains
  Project "1" *-- "1..*" ProjectPackage : decomposed into
  ProjectPackage "1" o-- "*" Proposal : receives bids
  ContractorProfile "1" --> "*" Proposal : authors
  Proposal "1" *-- "1..*" ProposalItem : itemized by
  ProjectPackage "0..1" --> "1" ContractorProfile : awarded to
  ProjectPackage "1" *-- "1..*" Milestone : executed through
  Milestone "1" *-- "*" ProgressUpdate : logs evidence
  ProjectPackage "1" *-- "*" ChangeRequest : governs
  Profile "1" --> "*" ChangeRequest : initiates
  ProjectPackage "1" o-- "0..1" Review : evaluated in
  Profile "1" --> "*" Review : authors
  ContractorProfile "1" --> "*" Review : receives
  Profile "1" --> "*" Notification : receives
  Profile "0..1" --> "*" AuditLog : triggers
